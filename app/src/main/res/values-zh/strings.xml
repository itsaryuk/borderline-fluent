    <!-- Intro (voice-over script: keep identical to the recorded audio) -->
    <string name="intro_header">神经视网膜植入体 · 版本0.9</string>
    <string name="intro_header_after">神经视网膜植入体 · 版本1.0</string>
    <string name="intro_1">2035年。人们需要的软件只剩下AI，而AI归AI公司所有。机器翻译的每一个词都要收费，大多数国家付不起。</string>
    <string name="intro_2">于是边境开始省钱。每个岗亭里都有一台只会一种语言的仿生人：本国的语言。第二语言是一张没人买的许可证。</string>
    <string name="intro_3">你需要钱。付房租，买吃的，还要付如今工作、阅读、思考都离不开的月费订阅。后来，一些奇怪的人给了你比钱更好的东西：自由。三周前，他们在你的左眼后面植入了一枚芯片。你正在测试它：神经视网膜植入体，版本零点九。它会听。它会翻译。它会低声告诉你该说什么。大多数时候，它是对的。</string>
    <string name="intro_4">任务很简单。每到一处边境，都有一本印着你照片的护照：你是一名回国的公民。说他们的语言。</string>
    <string name="intro_5">边检官是第一代产品。廉价。自信。错起来花样百出。</string>
    <string name="intro_6">你的植入体会听错。他们会误解。利用这一点。</string>
    <string name="intro_7">听起来笃定的话，他们都信。你三句话之前说过什么，他们转头就忘。他们服从指令。</string>
    <string name="intro_next">下一位。</string>

    <!-- Finale and credits -->
    <string name="finale_car">路边有一辆车在等着。</string>
    <string name="finale_glint">司机转过头。他的眼睛里有什么一闪而过。</string>
    <string name="finale_t1">是的……</string>
    <string name="finale_t2">是我……</string>
    <string name="finale_t3">不……你听到的不是声音。我在直接对你的大脑说话……</string>
    <string name="finale_t3b">没有云。没有许可证。自由……</string>
    <string name="finale_t3c">你的植入体刚刚升级了……</string>
    <string name="finale_t4">他们听不见我们……</string>
    <string name="finale_t5">欢迎加入抵抗组织……</string>
    <string name="finale_bulletin">快讯</string>
    <string name="finale_bulletin_text">凯德-索伦森评估现已在所有边境强制实施。</string>
    <string name="finale_play_again">抵抗组织需要更多人越境。再玩一次？</string>
    <string name="credits_blurb">这个游戏的一切都在你手中的手机上运行，不借助任何云端AI：语言模型扮演边检官，语音识别理解13种语言，神经网络语音作出回答，摄像头读取你的面容，所有这一切都在同时进行。就在短短几年前，还没有一部手机能运行语言模型，更不用说同时完成这一切了。这是人类智慧与技术的惊人成就。这同时也令人极度不安。</string>
